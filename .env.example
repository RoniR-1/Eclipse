# API keys: add as many numbered keys as you have (AI_API_KEY_5, AI_API_KEY_6, ... also work).
# Requests take turns across them; a rate-limited or rejected key is skipped and rested for AI_MODEL_RETRY_SECONDS.
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=
AI_API_KEY_4=
AI_API_KEY_MODEL=model1,model2,model3
AI_MODEL_RETRY_SECONDS=60
# 0 gives the most repeatable AI answers; leave blank if a model rejects the setting.
AI_TEMPERATURE=0
# Where AI answers are cached so the same input always gives the same numbers (default .local/ai-cache).
# Delete this folder to get fresh answers.
AI_CACHE_DIR=
AI_BASE_URL=

DATABASE_URL=postgresql://financial_twin:financial_twin@127.0.0.1:5433/financial_twin
